{
  "name": "mdt-crash-dashboard-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "The static front end: a no-server dashboard over one Montana county's MDT crash records.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run theme && npm run headers && astro dev",
    "theme": "node scripts/build-theme.mjs",
    "headers": "node scripts/build-headers.mjs",
    "build": "npm run theme && npm run headers && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:decode": "node scripts/verify-decode.mjs",
    "preview:csp": "node scripts/serve-csp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.8",
    "hyparquet": "^1.17.1",
    "hyparquet-compressors": "1.1.2",
    "maplibre-gl": "^6.13.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
